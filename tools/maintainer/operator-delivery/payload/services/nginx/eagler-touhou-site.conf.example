root /var/www/eagler-touhou;
index index.html;

gzip on;
gzip_types application/wasm application/javascript application/json text/css text/plain;
gzip_min_length 1024;

location = /favicon.ico { return 204; }

location = /eagler-touhou { return 302 /; }
location = /eagler-touhou/ { return 302 /; }
location = /eagler-touhou/app-shell-sw.js {
    default_type application/javascript;
    add_header Cache-Control "no-store";
    add_header Service-Worker-Allowed "/eagler-touhou/";
    try_files /legacy-mount-retirement-sw.js =404;
}
location ^~ /eagler-touhou/ {
    rewrite ^/eagler-touhou/(.*)$ /$1 break;
    try_files $uri $uri/ =404;
}

location /eagler-netplay/ {
    proxy_pass http://127.0.0.1:18142;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 75s;
}

location ~* \.(html|json)$ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
}
location ~* \.wasm$ {
    default_type application/wasm;
    if ($args ~ "v=") { add_header Cache-Control "public, max-age=31536000, immutable"; }
    if ($args !~ "v=") { add_header Cache-Control "no-cache"; }
    try_files $uri =404;
}
location ~* \.mjs$ {
    default_type application/javascript;
    if ($args ~ "v=") { add_header Cache-Control "public, max-age=31536000, immutable"; }
    if ($args !~ "v=") { add_header Cache-Control "no-cache"; }
    try_files $uri =404;
}
location ~* \.(js|data|css|woff|woff2|ttc|otf|jpg|jpeg|webp)$ {
    if ($args ~ "v=") { add_header Cache-Control "public, max-age=31536000, immutable"; }
    if ($args !~ "v=") { add_header Cache-Control "no-cache"; }
    try_files $uri =404;
}
location ~* \.(ogg|wav)$ {
    add_header Cache-Control "public, max-age=604800";
    try_files $uri =404;
}
location / { try_files $uri $uri/ =404; }

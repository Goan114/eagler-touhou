# This file belongs in nginx's http context via /etc/nginx/conf.d.
# Keep the exact old-origin migration document reachable over HTTP. Every
# other plain-HTTP navigation is sent cleanly to the HTTPS Launcher. Migration
# remains an explicit user action; a routine bare-domain visit must not imply
# that the visitor has old-Origin data.
map "$http_x_forwarded_proto|$scheme|$uri" $eagler_http_migration_redirect_@@MAP_ID@@ {
    default 0;
    ~^http\|[^|]+\|/migrate\.html$ 0;
    ~^\|http\|/migrate\.html$ 0;
    ~^http\| 1;
    ~^\|http\| 1;
}

{
  "name": "eagler-touhou",
  "version": "0.1.0",
  "description": "Browser Launcher and deployment toolkit for Touhou Project 6-8 ports, with local packages, offline support, touch controls, and multiplayer.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YomotsuHisami/eagler-touhou.git"
  },
  "homepage": "https://github.com/YomotsuHisami/eagler-touhou#readme",
  "bugs": {
    "url": "https://github.com/YomotsuHisami/eagler-touhou/issues"
  },
  "keywords": [
    "touhou",
    "webassembly",
    "emscripten",
    "launcher",
    "offline",
    "multiplayer"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:launcher": "node scripts/build-launcher.mjs --force",
    "host": "pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Start-eagler-touhou-host.ps1",
    "host:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Start-eagler-touhou-host.ps1 -BuildOnly",
    "host:inspect": "node scripts/inspect-quick-host.mjs",
    "host:doctor": "node scripts/inspect-quick-host.mjs",
    "import": "pwsh -NoProfile -ExecutionPolicy Bypass -File deploy/Build-QuickImport.ps1",
    "relay": "node scripts/build-launcher.mjs && node server/netplay-relay.mjs",
    "build:app-shell": "node scripts/build-app-shell.mjs",
    "refresh:deployment-app-shell": "node scripts/refresh-deployment-app-shell.mjs",
    "refresh:deployment-frontend": "node scripts/refresh-deployment-app-shell.mjs --frontend",
    "package:offline-game": "node scripts/package-offline-game.mjs",
    "package:runtime-release": "node scripts/package-runtime-release.mjs",
    "release": "node scripts/release.mjs",
    "vendor": "node scripts/vendor.mjs",
    "font:site": "node scripts/build-site-unifont.mjs",
    "font:ui": "node scripts/build-site-ui-fonts.mjs",
    "verify:server": "node scripts/verify-server-build.mjs",
    "verify:release": "node scripts/verify-release-bundle.mjs",
    "verify:deployed": "node scripts/verify-deployed-site.mjs",
    "verify:practice": "node scripts/verify-in-practice.mjs",
    "verify:migration-cutover": "node scripts/verify-origin-cutover.mjs",
    "verify:hsts-cutover": "node scripts/verify-hsts-cutover.mjs",
    "audit:publish": "node scripts/audit-publication.mjs",
    "audit:publish:workspace": "node scripts/audit-publication.mjs --workspace",
    "verify:unified": "node scripts/verify-unified-layout.mjs",
    "test:thcrap-static-pack": "node tests/test-thcrap-static-pack.mjs",
    "verify:thcrap-real": "node scripts/ops/verify-thcrap-real.mjs",
    "verify:public-relay:fallback": "node scripts/ops/verify-public-relay-fallback.mjs",
    "verify:public-relay:targeted": "node scripts/ops/verify-public-targeted-relay.mjs",
    "verify:public-turn": "python scripts/ops/verify-public-turn-quality.py",
    "test:touch": "node tests/test-touch-layout-model.mjs && node tests/test-game-preferences.mjs && node tests/test-touch-runtime-protocol.mjs && node tests/test-shell-protocol.mjs",
    "test:replay-determinism": "node tests/test-replay-determinism-contract.mjs",
    "test:runtime-release-host": "node tests/test-runtime-release-host-assembly.mjs",
    "test:package-store:browser": "python tests/test-package-update-atomicity-browser.py",
    "test:package-installer": "npm run test:package-store:browser",
    "test:webkit": "node tests/browser/playwright-webkit-gate.mjs",
    "test:browserstack:ios": "node tests/browser/playwright-webkit-gate.mjs --require-browserstack",
    "test:import-update:browser": "python tests/browser/import-update.py",
    "test:card-filter:browser": "python tests/test-card-filter-browser.py",
    "test:legacy-package:browser": "python tests/test-legacy-package-app-runtime-browser.py",
    "test:offline-reload:browser": "python tests/test-offline-reload-browser.py",
    "test:legacy-mount-retirement:browser": "python tests/test-legacy-mount-retirement-browser.py",
    "test:mp-runtime-exit:browser": "python tests/test-mp-runtime-exit-room.py",
    "test:th07mp-launch:browser": "python tests/test-th07mp-launch.py",
    "test:th07mp-ui:browser": "python tests/test-th07mp-ui.py",
    "test:th07mp-webrtc:browser": "python tests/test-th07mp-webrtc.py",
    "test:origin-migration": "node tests/test-origin-migration.mjs",
    "test:origin-migration:browser": "python tests/test-origin-migration-browser.py",
    "test:music-selection:browser": "python tests/browser/test-music-selection.py",
    "rebuild:web": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../Rebuild-Web-Runtimes.ps1",
    "prepare:thcrap": "node scripts/prepare-thcrap.mjs",
    "test:shell": "node tests/test-shell-protocol.mjs",
    "test:storage": "node tests/test-runtime-storage-contract.mjs",
    "test:runtime-protocol": "node tests/test-runtime-protocol-contract.mjs",
    "test:storage:browser": "python tests/test-runtime-storage-conformance.py",
    "test:browser-capabilities": "python tests/test-browser-capabilities.py",
    "test:multiplayer-replay-launcher:browser": "npm run build:launcher && python tests/test-multiplayer-replay-launcher-browser.py",
    "test:multiplayer-spectator-launcher:browser": "npm run build:launcher && python tests/test-multiplayer-spectator-launcher-browser.py",
    "test:th06-netplay-launcher:browser": "npm run build:launcher && python tests/test-th06-netplay-launcher-browser.py",
    "test:deployment-python": "pwsh -NoProfile -File tests/test-deployment-python-fallback.ps1",
    "test:server": "node tests/test-server.mjs",
    "check": "node scripts/check.mjs",
    "check:workspace": "node scripts/check.mjs --workspace"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "webaudio-tinysynth": "1.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "browserstack-local": "^1.5.13",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.10.0",
    "typescript": "7.0.2",
    "workbox-build": "^7.4.1"
  }
}
